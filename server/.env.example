PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/estatexplorer
JWT_ACCESS_SECRET=your_jwt_access_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
CLIENT_URL=http://localhost:5173

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=EstateXplorer <noreply@estatexplorer.com>
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# Disposable Email Protection
DISPOSABLE_EMAIL_API_URL=
DISPOSABLE_EMAIL_API_KEY=
DISPOSABLE_EMAIL_CACHE_TTL=3600000
DISPOSABLE_EMAIL_FAIL_MODE=allow

# Authentication Rate Limiting
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20

# SMS Gateway Configuration (India / International)
# Fast2SMS (India): Register at https://www.fast2sms.com/ and paste API key
FAST2SMS_API_KEY=your_fast2sms_api_key_here
FAST2SMS_ROUTE=q
# Twilio (International / US / UK):
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

